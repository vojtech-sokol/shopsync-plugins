<?xml version="1.0" encoding="UTF-8"?>
<!-- EXPEO1 with stavy=T: only <sklady> + <stavy> datasets (fast stock/price refresh, no card master data, no catalog). -->
<mrpEnvelope>
  <body>
    <mrpRequest>
      <request command="EXPEO1" requestId=""></request>
      <data>
        <filter>
          <fltvalue name="stavy">T</fltvalue>
          <fltvalue name="cisloSkladu">1..3</fltvalue>
        </filter>
      </data>
    </mrpRequest>
  </body>
</mrpEnvelope>
